# ─────────────────────────────────────────────────────────────────────
# Boxy — configuración de PRODUCCIÓN (copiar como .env en el servidor)
# Ver docs/DESPLIEGUE.md. Nunca subir el .env real a ningún repositorio.
# ─────────────────────────────────────────────────────────────────────

APP_NAME=Boxy
APP_ENV=production
# Sin trazas de error ni variables en pantalla
APP_DEBUG=false
# Generar con: php artisan key:generate
APP_KEY=
APP_TIMEZONE=America/Caracas
# Dirección pública con HTTPS
APP_URL=https://boxy.venz.cloud

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

# ── Modo de Boxy ──
# saas      = varias empresas con licencias mensuales
# dedicado  = una sola tienda dueña del sistema (sin licencias ni registro público)
# Para vender suscripciones mensuales: saas. Registro público = la landing deja crear
# cuentas con prueba gratis; en false solo el super-admin crea empresas (Panel Boxy).
BOXY_MODO=saas
BOXY_REGISTRO_PUBLICO=true
# Duración de la sesión web en minutos (960 = 16 h)
BOXY_SESION_MINUTOS=960
# PIN de supervisor: fallos permitidos por cajero cada 10 min y por día
BOXY_PIN_INTENTOS=5
BOXY_PIN_INTENTOS_DIA=15
# Dominios que pueden llamar a la API desde el navegador (CORS). Vacío = solo APP_URL.
# Solo hace falta si la web se sirve desde otro dominio que la API.
BOXY_ORIGENES=
# Super-admin que crea "php artisan db:seed" (la clave se genera sola si se deja vacía)
BOXY_SUPERADMIN_EMAIL=
BOXY_SUPERADMIN_PASSWORD=
# Respaldos: días que se guardan y carpeta extra para una copia (disco externo o nube)
BOXY_RESPALDOS_DIAS=30
BOXY_RESPALDOS_COPIAR_A=

# ── Tasas de cambio ──
# Mantener la verificación del certificado. Si PHP no la logra (cURL error 60),
# apuntar a un cacert.pem actualizado en vez de desactivarla.
TASAS_VERIFICAR_SSL=true
TASAS_CA_BUNDLE=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Días que se guarda la bitácora de seguridad (storage/logs/seguridad-*.log)
LOG_SEGURIDAD_DIAS=180

# ── Base de datos: usuario propio con clave (NO root) ──
# CREATE USER 'boxy'@'localhost' IDENTIFIED BY 'una-clave-larga';
# GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES, LOCK TABLES ON boxy.* TO 'boxy'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boxy
DB_USERNAME=boxy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=boxy_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@venz.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Cuenta de prueba comercial (php artisan db:seed --class=CuentaPruebaSeeder)
BOXY_DEMO_EMAIL=aristides@boxy.com
BOXY_DEMO_NOMBRE="Aristides"
# La clave va SOLO aquí, nunca en el código. Vacía = se genera y se muestra una vez.
BOXY_DEMO_PASSWORD=

# Cobro de licencias (SaaS): se muestran al cliente en "Mi licencia". Vacío = no se muestra.
BOXY_COBRO_PAGO_MOVIL=
BOXY_COBRO_TRANSFERENCIA=
BOXY_COBRO_USDT=
BOXY_COBRO_BINANCE=
BOXY_COBRO_ZELLE=
# Contacto comercial (landing y "Mi licencia"). WhatsApp en formato internacional: 584140000000
BOXY_VENTAS_WHATSAPP=
BOXY_VENTAS_EMAIL=
